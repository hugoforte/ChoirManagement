# Frontend (Vite only exposes VITE_-prefixed vars to client code)
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Convex backend env (set via `npx convex env set`, not this file)
# CLERK_JWT_ISSUER_DOMAIN=
#
# Bulletin email (#52) — all optional. With any of the first three unset, the
# app treats email as unconfigured: publishing still works and nobody is
# emailed. See Step 8 of docs/guides/self-hosting.md.
# RESEND_API_KEY=
# BULLETINS_FROM_EMAIL=
# APP_BASE_URL=
# RESEND_WEBHOOK_SECRET=
