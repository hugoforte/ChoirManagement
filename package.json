{
  "name": "choir-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "vite build",
    "codegen": "convex codegen",
    "check": "tsc -p convex --noEmit --pretty false && tsc -p . --noEmit --pretty false && vite build",
    "lint": "npm run codegen && npm run check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.31.0",
    "convex": "^1.34.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@clerk/backend": "^3.17.2",
    "@clerk/testing": "^2.2.34",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "convex-test": "^0.0.37",
    "dotenv": "^17.4.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
